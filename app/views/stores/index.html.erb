<body style="background-color:#e59ae2">

<a href="/books"> Go to Books </a>

<h1 style="text-align:center"> All Stores </h1>
<br>
<br>

<% @stores_most_recent.each do |store| %>
    <h2> <%= link_to "Go to #{store.city} Store", "/stores/#{store.id}" %> </h3>
    <p> Date Created: <%= store.created_formatted %> </p>
    <%= button_to "Update #{store.city} Store", "/stores/#{store.id}/edit", method: :get %>
    <%= button_to "Delete #{store.city} Store", "/stores/#{store.id}", method: :delete %>
<% end %>

<br>

<%= link_to "New Store", "/stores/new" %>

</body>