<body style="background-color:#e59ae2">

<p><a href="/stores" style="margin-right: 50px;"> Go to Stores </a>     <a href="/books"> Go to Books </a> </p>

<h1 style="text-align:center"> <%= @book.name %> </h1>
<br>

<h3> Series: <%= @book.series %> </h3>
<h3> Volume: <%= @book.volume %> </h3>
<h3> On Display: <%= @book.on_display %> </h3>

<br>
<br>

<%= button_to "Update Book", "/books/#{@book.id}/edit", method: :get %>
<%= button_to "Delete Book", "/books/#{@book.id}", method: :delete %>

</body>