<body style="background-color:#e59ae2">

<h1 style="text-align:center"> Edit <%= "#{@book.name}" %> </h1>
<h3 style="text-align:center"> Located at the <%= "#{@store.city}" %> Store </h3>

<%= form_with url: "/books/#{@book.id}", method: :patch, local: true do |form| %>
    <%= form.label :name %>
    <%= form.text_field :name, value: @book.name %>
    <br>
    <%= form.label :series %>
    <%= form.text_field :series, value: @book.series %>
    <br>
    <%= form.label :volume %>
    <%= form.text_field :volume, value: @book.volume %>
    <br>
    <%= form.label :on_display %>
    <%= form.select :on_display, [['Yes', true], ['No', false]], :selected => @book.on_display %>
    <br>
    <br>
    <%= form.submit 'Update Book' %>


<% end %>