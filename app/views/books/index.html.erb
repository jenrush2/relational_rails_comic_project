<body style="background-color:#e59ae2">

<a href="/stores"> Go to Stores </a>

<h1 style="text-align:center"> All Books Currently On Display </h1>
<br>
<br>

<% @books_on_display.each do |book| %>
    <h3> <%= link_to "#{book.name}", "/books/#{book.id}" %> </h3>
    <p> Series: <%= book.series %> </p>
    <p> Volume: <%= book.volume %> </p>
    <p> On Display: <%= book.on_display %> </p>
    <p> <%= button_to "Edit #{book.name}", "/books/#{book.id}/edit", method: :get %> </p>
    <p> <%= button_to "Delete #{book.name}", "/books/#{book.id}", method: :delete %> </p>

<% end %>

<br>
<br>

<a href="/books/all"> Show All Books </a>



</body>